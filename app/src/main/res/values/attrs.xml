<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Liquid glass views: LiquidGlassButton, GlassCardLayout, GlassTextView (com.queuekiosk.ui.glass) -->
    <declare-styleable name="GlassView">
        <!-- Tint of the glass. Buttons default to primary, cards to card, GlassTextView to clear. -->
        <attr name="glassVariant" format="enum">
            <enum name="primary" value="0" />
            <enum name="clear" value="1" />
            <enum name="card" value="2" />
            <enum name="danger" value="3" />
        </attr>
        <attr name="glassCornerRadius" format="dimension" />
    </declare-styleable>
</resources>
